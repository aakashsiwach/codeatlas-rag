    "/api/webhook/github": {
      "post": {
        "operationId": "github_webhook_api_webhook_github_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-github-event",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Github-Event",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-hub-signature-256",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Hub-Signature-256"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Github Webhook Api Webhook Github Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
