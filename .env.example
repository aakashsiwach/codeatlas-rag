# Copy to .env and fill in. Every setting can also be passed as an environment variable.

# Where the index (SQLite + embedded Qdrant + traces) lives, and the default repo to index
CODEATLAS_INDEX_DIR=.codeatlas
# CODEATLAS_REPO_PATH=./repos/spring-petclinic

# Qdrant server; leave unset to use embedded Qdrant under the index dir
# CODEATLAS_QDRANT_URL=http://localhost:6333

# Embeddings: local (sentence-transformers) | openai | voyage | hashing
CODEATLAS_EMBEDDING_PROVIDER=local
CODEATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CODEATLAS_EMBEDDING_COST_PER_MTOK=0.02

# Cross-encoder reranker (set to empty to disable)
CODEATLAS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Answer generation: anthropic | openai | bedrock | none
CODEATLAS_LLM_PROVIDER=anthropic
CODEATLAS_LLM_MODEL=<model-id>
# USD per million tokens, per "<provider>:<model>" (Bedrock and the Anthropic API are separate entries).
# Fill in from your provider's price list; models without an entry are reported as "unpriced".
# CODEATLAS_LLM_PRICES={"bedrock:<model-id>": {"input_per_mtok": 0, "output_per_mtok": 0}, "anthropic:<model-id>": {"input_per_mtok": 0, "output_per_mtok": 0}}
# CODEATLAS_LLM_BASE_URL=http://localhost:11434/v1   # OpenAI-compatible servers
# CODEATLAS_AWS_REGION=us-east-1                     # bedrock
# CODEATLAS_AWS_PROFILE=<profile>                    # bedrock: named profile in ~/.aws (default chain if unset)
# CODEATLAS_JUDGE_THINKING=disabled                 # thinking type for judge calls; empty = model default

# Provider credentials (read by the provider SDKs)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=

# Retrieval defaults and refusal thresholds (tune these with `codeatlas eval`)
CODEATLAS_DEFAULT_MODE=hybrid+rerank+graph
CODEATLAS_DEFAULT_K=8
CODEATLAS_MIN_VECTOR_SIMILARITY=0.30
CODEATLAS_MIN_RERANK_CONFIDENCE=0.05
# Per-model thresholds override the two above (scores differ in scale between models); calibrate on dev
# with `codeatlas eval eval/petclinic-dev.yaml --calibrate`.
# CODEATLAS_MIN_CONFIDENCE_BY_MODEL={"<embedder name or reranker model>": 0.0}

# GitHub webhook for incremental re-indexing
# CODEATLAS_WEBHOOK_SECRET=change-me
# CODEATLAS_WEBHOOK_BRANCH=main
# CODEATLAS_GIT_PULL_ON_WEBHOOK=true

# HTTP API access. With a token set, every /api/* call needs "Authorization: Bearer <token>".
# `codeatlas serve` refuses a non-loopback host without a token unless ALLOW_UNAUTHENTICATED is set.
# CODEATLAS_API_TOKEN=change-me
# CODEATLAS_ALLOW_UNAUTHENTICATED=false
# CODEATLAS_ALLOW_INDEX_ANY_PATH=false                # let POST /api/index index other directories

# LLM request limits: per-request timeout and retries with backoff on throttling/transient errors
# CODEATLAS_LLM_TIMEOUT_S=120
# CODEATLAS_LLM_MAX_RETRIES=4
